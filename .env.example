# Required: Groq API key
GROQ_API_KEY=GROQ_API_KEY

# Session token lifetime in hours (POST /login returns a bearer token)
TOKEN_TTL_HOURS=24

# Comma-separated CNICs allowed to log in (12345-1234567-1 or 13 plain digits).
# Empty means no CNIC can log in.
AUTHORIZED_CNICS=42101-2345678-9,35202-1234567-1

# Set to 1 when the API runs behind a trusted reverse proxy (rate limiting then keys on the real client IP)
TRUSTED_PROXY=0

# Comma-separated list of allowed browser origins (add your Vercel domain in production)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# Maximum upload size in MB
MAX_UPLOAD_MB=200

# Maximum vision-model calls per request (bounds LLM cost on long videos)
MAX_FRAMES_TO_ANALYZE=30

# Default language(s) for frame descriptions when the client sends no "language"
# field: comma-separated codes from {en, ur}. "en" = English only, "ur" = Urdu
# only, "en,ur" = both. Per-request, the API accepts the same codes.
DESCRIPTION_LANGUAGES=en,ur

# Per-IP request limit per minute (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=30
