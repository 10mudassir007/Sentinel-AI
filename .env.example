# Required: Groq API key
GROQ_API_KEY=GROQ_API_KEY
GOOGLE_API_KEY=GOOGLE_API_KEY
# Port served by `python main.py` (docker-compose maps the same port)
PORT=8754

# Session token lifetime in hours (POST /login returns a bearer token)
TOKEN_TTL_HOURS=24

# Semicolon-separated Argon2id hashes of CNICs allowed to log in - never
# store plaintext CNICs. Generate a hash with:  python tools/hash_cnic.py <cnic>
# (multiple CNICs: join their hashes with ; ; empty means no CNIC can log in)
AUTHORIZED_CNICS=

# Set to 1 when the API runs behind a trusted reverse proxy (rate limiting and
# the per-source queue then key on the real client IP)
TRUSTED_PROXY=0

# Comma-separated list of allowed browser origins (add your Vercel domain in production)
CORS_ORIGINS=http://localhost:8754,http://localhost:5173,http://127.0.0.1:8754

# Maximum upload size in MB
MAX_UPLOAD_MB=200

# Maximum video duration in seconds; longer uploads are rejected (422)
# before any analysis work starts.
MAX_VIDEO_SECONDS=15

# Maximum vision-model calls per request (bounds LLM cost on long videos)
MAX_FRAMES_TO_ANALYZE=30

# --- YOLO detection gating ---
# Frames reach the LLM only when motion is detected AND YOLO finds an interest
# class above the confidence threshold; everything else is discarded locally.
# Runs on the stock COCO model - no custom training needed.
YOLO_MODEL_PATH=yolo26n.pt
YOLO_CONF_THRESHOLD=0.45
# Comma-separated base-COCO class names that justify escalation: person
# (falls/fights/robberies), vehicles (crashes), knife (COCO's weapon class).
YOLO_INTEREST_CLASSES=person,bicycle,car,motorcycle,bus,truck,knife

# --- Per-camera escalation state machine ---
# One incident lifecycle per camera: IDLE -> SUSPICIOUS -> CONFIRMING ->
# ALERT -> COOLDOWN. The vision LLM runs only on the SUSPICIOUS -> CONFIRMING
# transition; only repeated gated detections while CONFIRMING authorize the
# agent to call 1122 over the SIP trunk. COOLDOWN throttles re-alerts, so a
# single camera can never flood the dispatcher. Send the same camera_id on
# every upload from a camera to get true cross-upload throttling.

# Seconds SUSPICIOUS/CONFIRMING may go without a gated detection before
# the lifecycle decays back to IDLE.
ESCALATION_WINDOW_S=60
# Gated detections required while CONFIRMING to escalate to ALERT and
# dispatch (minimum 2: entering CONFIRMING is the first confirming hit).
ESCALATION_CONFIRMING_HITS=3
# Seconds ALERT persists before decaying back to IDLE if dispatch never
# finishes.
ESCALATION_ALERT_TIMEOUT_S=30
# Seconds after a dispatch attempt before the same camera may alert again
# (0 disables the cooldown).
ESCALATION_COOLDOWN_S=300

# --- Per-source processing queue ---
# Requests from the same source (same camera_id, or same client IP when no
# camera_id is sent) are serialized: a new clip is queued and starts
# processing only after the previous analysis finished and its response was
# sent back.

# Default language(s) for frame descriptions when the client sends no "language"
# field: comma-separated codes from {en, ur}. "en" = English only, "ur" = Urdu
# only, "en,ur" = both. Per-request, the API accepts the same codes.
DESCRIPTION_LANGUAGES=en,ur

# Per-IP request limit per minute (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=30

# --- Emergency dispatch (Asterisk AMI over SIP trunk) ---
# Calls are originated as PJSIP/<number>@sentinel-trunk; your dialplan
# (context sentinel-outbound, exten alert) plays ${ALERT_FILE}.
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=sentinel_api
AMI_SECRET=your_strong_ami_password

# Voice message synthesis: ElevenLabs when a key is set, else edge-tts (no key).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Shared directory the API writes alert-*.wav into for Asterisk to play.
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/sentinel/

# Directory served by GET /audio/{filename} so generated audio can be returned.
AUDIO_OUTPUT_DIR=generated_audio

# Reverse-geocoding endpoint: turns client latitude/longitude into a readable
# location used in the voice message and the analysis. Only the host part is
# used (geopy Nominatim); it must be Nominatim-compatible. Nominatim needs no
# key; point this at your own Nominatim server if you prefer.
REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
