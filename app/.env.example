# Sentinel AI Mobile App — copy this file to .env and adjust the values.
# Only variables prefixed EXPO_PUBLIC_ reach the app bundle (Expo SDK 49+).
# After changing this file, restart the dev server with: npx expo start -c

# Default backend API URL. A physical phone cannot use "localhost" — it points
# at the phone itself. Use the LAN IP of the machine running `python main.py`
# and make sure the phone can reach it (same Wi-Fi + Windows Firewall allow rule).

# LAN mode — replace with the LAN IP of the machine running the backend
# (the API serves port 8754 by default; find your IP with `ipconfig`):
EXPO_PUBLIC_API_URL=http://192.168.1.100:8754

# Android emulator (reaches the host machine via 10.0.2.2):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8754

# The in-app Settings screen overrides this value at runtime (persisted per install).
