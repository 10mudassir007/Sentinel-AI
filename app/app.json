{
  "expo": {
    "name": "Sentinel AI",
    "slug": "sentinel-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0E1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sentinelai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to record video footage for AI-based emergency detection.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used to upload demo videos for analysis.",
        "NSMicrophoneUsageDescription": "Microphone is used during video recording.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.sentinelai.app",
      "enableProguardInReleaseBuilds": true,
      "enableSeparateBuildPerCPUArchitecture": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is used to record video footage for AI-based emergency detection."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is used to upload demo videos for analysis."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is sent along with emergency video footage to help responders reach you faster."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "8796d6ee-94c1-4ac1-bfa9-fa609735429b"
      }
    }
  }
}
