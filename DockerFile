FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# ffmpeg converts edge-tts mp3 output to WAV for Asterisk playback.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ensure YOLO weights are available: if yolo11m.pt was copied from the repo
# (local builds) this just validates it; if not (CI builds where .pt files are
# git-ignored), ultralytics downloads it from the release hub.
RUN python -c "from ultralytics import YOLO; YOLO('yolo11m.pt')"

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/generated_audio /app/data \
    && chown -R appuser:appuser /app/generated_audio /app/data
USER appuser

EXPOSE 8754

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8754/health')"

# Same entry point as `python main.py` so both run modes behave identically.
CMD ["python", "main.py"]
